{
  "name": "task-manager",
  "productName": "Practice Manager",
  "version": "1.0.1",
  "description": "Task Manager and Attendance System",
  "author": "Zaheera",
  "homepage": "https://github.com/soudagarzaheera/Task-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/soudagarzaheera/Task-manager.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "release:win": "vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jspdf": "^2.5.2",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "com.soudagarzaheera.practicemanager",
    "productName": "Practice Manager",
    "copyright": "Copyright © Zaheera",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Practice Manager",
      "artifactName": "Practice-Manager-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soudagarzaheera",
        "repo": "Task-manager",
        "releaseType": "release"
      }
    ]
  }
}
