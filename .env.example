# Supabase Configuration
# IMPORTANT: Use ONLY your project URL and public/anon key (publishable key).
# NEVER expose the service_role key or database password in frontend code.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# The service-role key used by supabase/functions/create-employee is NOT a
# Vite variable and does not belong in this file. Supabase injects
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY into every
# Edge Function automatically — nothing to set manually for that function.
